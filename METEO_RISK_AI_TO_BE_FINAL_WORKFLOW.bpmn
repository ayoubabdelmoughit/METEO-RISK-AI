<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_METEO_RISK_FINAL"
  targetNamespace="http://meteo-risk-ai.com/bpmn/final">

  <bpmn:dataStore id="DataStore_Risk" name="Meteo_Risk"/>
  <bpmn:dataStore id="DataStore_Incidents" name="Meteo_Incidents_History"/>
  <bpmn:dataStore id="DataStore_Reports" name="Meteo_AI_Reports"/>

  <bpmn:process id="Process_METEO_RISK_FINAL" name="METEO-RISK AI — Workflow final implémenté" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Final">
      <bpmn:lane id="Lane_Data" name="Sources &amp; acquisition">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Acquire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Risk" name="METEO-RISK AI — Risk Engine">
        <bpmn:flowNodeRef>RiskCalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RiskClass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RiskGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Medium</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>High</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Critical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndLow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Incident" name="Alertes &amp; gestion d'incident">
        <bpmn:flowNodeRef>AlertMgr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateInc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntervGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveInc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SlackTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartInterv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HistProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndMedium</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recovery" name="Recovery &amp; clôture">
        <bpmn:flowNodeRef>FindActive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ActiveGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckRecovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryGW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MonitorLoop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HistoryFinal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="IA, reporting &amp; communication">
        <bpmn:flowNodeRef>PrepReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Agent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinalNotif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Nouvelle exécution / nouvelle observation">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Acquire" name="Collecter météo + géolocalisation + capteur IoT">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Merge" name="Fusionner les données">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="RiskCalc" name="Calculer Flood Risk Score">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="RiskClass" name="Classifier le risque">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="RiskGW" name="Niveau de risque ?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Low" name="LOW — Surveillance normale">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Medium" name="MEDIUM — Vigilance renforcée">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="High" name="HIGH — Alerte">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Critical" name="CRITICAL — Emergency">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AlertMgr" name="Alert Manager">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="NotifGW" name="Notification requise ?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Notify" name="Créer message + envoyer Gmail">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CreateInc" name="Créer incident">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="IntervGW" name="Intervention requise ?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Assign" name="Affecter équipe / action">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SaveInc" name="Enregistrer incident dans MongoDB">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SlackTeam" name="Notifier l'équipe sur Slack">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="StartInterv" name="Démarrer intervention">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="HistProgress" name="Mettre à jour MongoDB + historique IN_PROGRESS">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FindActive" name="Rechercher incident actif">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ActiveGW" name="Incident actif ?">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="CheckRecovery" name="Check Recovery : eau &lt; seuil + risque LOW + tendance non montante">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="RecoveryGW" name="Recovery prêt ?">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MonitorLoop" name="Continuer la surveillance">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Complete" name="COMPLETED — terminer intervention">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Resolve" name="RESOLVED — résoudre incident">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Close" name="CLOSED — clôturer incident">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="HistoryFinal" name="Mettre à jour MongoDB + historiques COMPLETED / RESOLVED / CLOSED">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PrepReport" name="Préparer données du rapport IA">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Agent" name="Agent IA + Groq LLM : générer rapport">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SaveReport" name="Sauvegarder AI Incident Report dans MongoDB">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FinalNotif" name="Notification finale Slack + Gmail">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Dashboard" name="Dashboard temps réel — lecture MongoDB / API">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Incident clôturé et communiqué">
      <bpmn:incoming>F41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndLow" name="Surveillance normale">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndMedium" name="Vigilance / suivi sans intervention">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>


    <bpmn:dataStoreReference id="DS_Risk" name="MongoDB — Meteo_Risk" dataStoreRef="DataStore_Risk"/>
    <bpmn:dataStoreReference id="DS_Incidents" name="MongoDB — Meteo_Incidents / History" dataStoreRef="DataStore_Incidents"/>
    <bpmn:dataStoreReference id="DS_Reports" name="MongoDB — Meteo_AI_Reports" dataStoreRef="DataStore_Reports"/>


    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Acquire"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Acquire" targetRef="Merge"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Merge" targetRef="RiskCalc"/>
    <bpmn:sequenceFlow id="F4" sourceRef="RiskCalc" targetRef="RiskClass"/>
    <bpmn:sequenceFlow id="F5" sourceRef="RiskClass" targetRef="RiskGW"/>
    <bpmn:sequenceFlow id="F6" name="LOW" sourceRef="RiskGW" targetRef="Low"/>
    <bpmn:sequenceFlow id="F7" name="MEDIUM" sourceRef="RiskGW" targetRef="Medium"/>
    <bpmn:sequenceFlow id="F8" name="HIGH" sourceRef="RiskGW" targetRef="High"/>
    <bpmn:sequenceFlow id="F9" name="CRITICAL" sourceRef="RiskGW" targetRef="Critical"/>
    <bpmn:sequenceFlow id="F10" name="Vérifier recovery si incident actif" sourceRef="Low" targetRef="FindActive"/>
    <bpmn:sequenceFlow id="F11" name="Aucun incident actif" sourceRef="Low" targetRef="EndLow"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Medium" targetRef="AlertMgr"/>
    <bpmn:sequenceFlow id="F13" sourceRef="High" targetRef="AlertMgr"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Critical" targetRef="AlertMgr"/>
    <bpmn:sequenceFlow id="F15" sourceRef="AlertMgr" targetRef="NotifGW"/>
    <bpmn:sequenceFlow id="F16" name="Oui" sourceRef="NotifGW" targetRef="Notify"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Notify" targetRef="CreateInc"/>
    <bpmn:sequenceFlow id="F18" sourceRef="CreateInc" targetRef="IntervGW"/>
    <bpmn:sequenceFlow id="F19" name="Oui — HIGH / CRITICAL" sourceRef="IntervGW" targetRef="Assign"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Assign" targetRef="SaveInc"/>
    <bpmn:sequenceFlow id="F21" sourceRef="SaveInc" targetRef="SlackTeam"/>
    <bpmn:sequenceFlow id="F22" sourceRef="SlackTeam" targetRef="StartInterv"/>
    <bpmn:sequenceFlow id="F23" sourceRef="StartInterv" targetRef="HistProgress"/>
    <bpmn:sequenceFlow id="F24" name="Nouvelles mesures" sourceRef="HistProgress" targetRef="FindActive"/>
    <bpmn:sequenceFlow id="F25" name="Non — MEDIUM" sourceRef="IntervGW" targetRef="EndMedium"/>
    <bpmn:sequenceFlow id="F26" sourceRef="FindActive" targetRef="ActiveGW"/>
    <bpmn:sequenceFlow id="F27" name="Oui" sourceRef="ActiveGW" targetRef="CheckRecovery"/>
    <bpmn:sequenceFlow id="F28" name="Non" sourceRef="ActiveGW" targetRef="EndLow"/>
    <bpmn:sequenceFlow id="F29" sourceRef="CheckRecovery" targetRef="RecoveryGW"/>
    <bpmn:sequenceFlow id="F30" name="Oui" sourceRef="RecoveryGW" targetRef="Complete"/>
    <bpmn:sequenceFlow id="F31" name="Non" sourceRef="RecoveryGW" targetRef="MonitorLoop"/>
    <bpmn:sequenceFlow id="F32" name="Nouvelle observation" sourceRef="MonitorLoop" targetRef="FindActive"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Complete" targetRef="Resolve"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Resolve" targetRef="Close"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Close" targetRef="HistoryFinal"/>
    <bpmn:sequenceFlow id="F36" sourceRef="HistoryFinal" targetRef="PrepReport"/>
    <bpmn:sequenceFlow id="F37" sourceRef="PrepReport" targetRef="Agent"/>
    <bpmn:sequenceFlow id="F38" sourceRef="Agent" targetRef="SaveReport"/>
    <bpmn:sequenceFlow id="F39" sourceRef="SaveReport" targetRef="FinalNotif"/>
    <bpmn:sequenceFlow id="F40" sourceRef="FinalNotif" targetRef="Dashboard"/>
    <bpmn:sequenceFlow id="F41" sourceRef="Dashboard" targetRef="End"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Final">
    <bpmn:participant id="Participant" name="METEO-RISK AI — AI Flood Early Warning & Incident Management" processRef="Process_METEO_RISK_FINAL"/>
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Final">
    <bpmndi:BPMNPlane id="BPMNPlane_Final" bpmnElement="Collaboration_Final">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true">
        <dc:Bounds x="100" y="50" width="4530" height="1070"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Data_di" bpmnElement="Lane_Data" isHorizontal="true">
        <dc:Bounds x="130" y="50" width="4500" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Risk_di" bpmnElement="Lane_Risk" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="4500" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Incident_di" bpmnElement="Lane_Incident" isHorizontal="true">
        <dc:Bounds x="130" y="540" width="4500" height="210"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Recovery_di" bpmnElement="Lane_Recovery" isHorizontal="true">
        <dc:Bounds x="130" y="750" width="4500" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI" isHorizontal="true">
        <dc:Bounds x="130" y="950" width="4500" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="180" y="105" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Acquire_di" bpmnElement="Acquire">
        <dc:Bounds x="270" y="85" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_di" bpmnElement="Merge">
        <dc:Bounds x="535" y="85" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RiskCalc_di" bpmnElement="RiskCalc">
        <dc:Bounds x="740" y="245" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RiskClass_di" bpmnElement="RiskClass">
        <dc:Bounds x="965" y="245" width="155" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RiskGW_di" bpmnElement="RiskGW" isMarkerVisible="true">
        <dc:Bounds x="1170" y="260" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Low_di" bpmnElement="Low">
        <dc:Bounds x="1280" y="205" width="170" height="65"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Medium_di" bpmnElement="Medium">
        <dc:Bounds x="1280" y="285" width="190" height="65"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="High_di" bpmnElement="High">
        <dc:Bounds x="1280" y="365" width="160" height="65"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Critical_di" bpmnElement="Critical">
        <dc:Bounds x="1280" y="445" width="180" height="65"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AlertMgr_di" bpmnElement="AlertMgr">
        <dc:Bounds x="1520" y="365" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifGW_di" bpmnElement="NotifGW" isMarkerVisible="true">
        <dc:Bounds x="1720" y="375" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify">
        <dc:Bounds x="1820" y="330" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateInc_di" bpmnElement="CreateInc">
        <dc:Bounds x="1820" y="425" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntervGW_di" bpmnElement="IntervGW" isMarkerVisible="true">
        <dc:Bounds x="2020" y="435" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Assign_di" bpmnElement="Assign">
        <dc:Bounds x="2120" y="390" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SaveInc_di" bpmnElement="SaveInc">
        <dc:Bounds x="2350" y="390" width="210" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SlackTeam_di" bpmnElement="SlackTeam">
        <dc:Bounds x="2610" y="390" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartInterv_di" bpmnElement="StartInterv">
        <dc:Bounds x="2840" y="390" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HistProgress_di" bpmnElement="HistProgress">
        <dc:Bounds x="3060" y="390" width="240" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FindActive_di" bpmnElement="FindActive">
        <dc:Bounds x="1280" y="780" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ActiveGW_di" bpmnElement="ActiveGW" isMarkerVisible="true">
        <dc:Bounds x="1505" y="790" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckRecovery_di" bpmnElement="CheckRecovery">
        <dc:Bounds x="1605" y="755" width="280" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecoveryGW_di" bpmnElement="RecoveryGW" isMarkerVisible="true">
        <dc:Bounds x="1935" y="790" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MonitorLoop_di" bpmnElement="MonitorLoop">
        <dc:Bounds x="2050" y="870" width="175" height="65"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Complete_di" bpmnElement="Complete">
        <dc:Bounds x="2050" y="740" width="210" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Resolve_di" bpmnElement="Resolve">
        <dc:Bounds x="2310" y="740" width="195" height="70"/>
      </bpmndi:BPMNShape>
